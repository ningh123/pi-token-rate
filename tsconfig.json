{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": [
			"node"
		]
	},
	"include": ["index.ts", "metrics.ts", "rate-view.ts", "__tests__/*.ts"]
}
